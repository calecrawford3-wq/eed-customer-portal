{
  "name": "StoreCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Inventory part category this card represents (e.g. block, valvetrain, gaskets)"
    },
    "label": {
      "type": "string",
      "description": "Display name shown on the public store category card"
    },
    "image_url": {
      "type": "string",
      "description": "Public image shown on the category card"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Lower numbers appear first"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "When false the category card is hidden from the public store"
    }
  },
  "required": [
    "category_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}