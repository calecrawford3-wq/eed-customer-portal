{
  "name": "SimAuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "e.g. simulation_run, training_approved, rule_edited, data_imported"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "details": {
      "type": "string",
      "description": "JSON of extra context (model version, ruleset version, weights)"
    },
    "model_version": {
      "type": "string"
    },
    "ruleset_version": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "entity_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}