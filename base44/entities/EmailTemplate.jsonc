{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name shown in the picker"
    },
    "subject": {
      "type": "string",
      "description": "Prefilled subject (optional)"
    },
    "body": {
      "type": "string",
      "description": "Prefilled message body"
    },
    "category": {
      "type": "string",
      "description": "Optional grouping label"
    }
  },
  "required": [
    "name",
    "body"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}