{
  "name": "EngineComponent",
  "type": "object",
  "properties": {
    "component_code": {
      "type": "string",
      "description": "Permanent human-readable component identity, e.g. HD-482731."
    },
    "component_type": {
      "type": "string",
      "enum": [
        "cylinder_head",
        "engine_case"
      ],
      "description": "Serialized engine component type."
    },
    "tag_code": {
      "type": "string",
      "description": "Immutable internal scan code encoded on the laser tag."
    },
    "platform_id": {
      "type": "string",
      "description": "Engine platform this component was created for, when known."
    },
    "origin_customer_engine_id": {
      "type": "string",
      "description": "Engine this component was first created with."
    },
    "current_customer_engine_id": {
      "type": "string",
      "description": "Bottom end/case this component is currently paired to; blank when unpaired."
    },
    "status": {
      "type": "string",
      "enum": [
        "paired",
        "unpaired",
        "retired"
      ],
      "default": "unpaired"
    },
    "notes": {
      "type": "string"
    },
    "storage_location": {
      "type": "string",
      "description": "Current physical shop location of this serialized component."
    },
    "physical_serial_number": {
      "type": "string",
      "description": "OEM/physical serial number when present, primarily for engine cases."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "in_machining",
        "waiting_on_parts",
        "spare",
        "damaged",
        "retired",
        "scrapped"
      ],
      "default": "active",
      "description": "Physical component lifecycle independent of pairing and inventory ownership."
    },
    "engine_core_id": {
      "type": "string",
      "description": "EngineCore catalog/SKU record this serialized physical core belongs to."
    },
    "inventory_state": {
      "type": "string",
      "enum": [
        "not_inventory",
        "in_stock",
        "reserved",
        "in_repair",
        "installed",
        "customer_owned",
        "scrapped"
      ],
      "default": "not_inventory",
      "description": "Serialized core inventory state. Separate from lifecycle and pairing."
    },
    "core_credit_value": {
      "type": "number",
      "description": "Core credit/value snapshot assigned to this physical component."
    },
    "acquired_from_customer_id": {
      "type": "string"
    },
    "acquired_job_id": {
      "type": "string"
    },
    "current_tag_version_id": {
      "type": "string"
    },
    "verification_invalidated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Latest physical change that invalidates earlier QC verification."
    },
    "verification_invalidation_reason": {
      "type": "string"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_reason": {
      "type": "string"
    },
    "acquisition_cost": {
      "type": "number",
      "description": "Amount Elite paid or credited to acquire this physical component into inventory."
    },
    "repair_cost_total": {
      "type": "number",
      "description": "Cumulative internal/outside repair spend invested in this physical component."
    },
    "total_invested_cost": {
      "type": "number",
      "description": "Acquisition cost plus cumulative repair spend."
    },
    "sell_value": {
      "type": "number",
      "description": "Current intended sell value/price for this serialized component."
    },
    "last_inventory_reason": {
      "type": "string",
      "description": "Most recent reason this component entered inventory or repair."
    },
    "last_inventory_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_repair_ticket_id": {
      "type": "string"
    },
    "legacy_identity_reference": {
      "type": "string",
      "description": "Historical seal/tag/reference preserved during legacy tag backfill."
    }
  },
  "required": [
    "component_code",
    "component_type",
    "tag_code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
