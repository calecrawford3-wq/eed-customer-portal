{
  "name": "WebsiteTestimonial",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "number"
    }
  },
  "required": [
    "customer_name",
    "quote"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}