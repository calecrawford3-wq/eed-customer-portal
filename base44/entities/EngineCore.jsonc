{
  "name": "EngineCore",
  "type": "object",
  "properties": {
    "core_number": {
      "type": "string",
      "description": "Core SKU / identifier (e.g. CORE-GSX600-BLOCK)"
    },
    "name": {
      "type": "string",
      "description": "Core display name"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "block",
        "cylinder_head",
        "rotating_assembly",
        "crankshaft",
        "valvetrain",
        "timing",
        "oiling",
        "other"
      ],
      "default": "block",
      "description": "Core category"
    },
    "platform_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Compatible engine platform IDs"
    },
    "condition": {
      "type": "string",
      "enum": [
        "rebuildable",
        "needs_inspection",
        "good",
        "scrap"
      ],
      "default": "rebuildable",
      "description": "Physical condition of the core"
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0,
      "description": "Number of cores currently in stock"
    },
    "unit_cost": {
      "type": "number",
      "description": "Core value / your cost for this core"
    },
    "sell_price": {
      "type": "number",
      "description": "Price when selling this core to a customer"
    },
    "core_credit": {
      "type": "number",
      "description": "Credit given to a customer when buying their core or doing a core swap"
    },
    "location": {
      "type": "string",
      "description": "Physical storage location"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo URLs of the core for visual damage reference without opening the storage box"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "list_online": {
      "type": "boolean",
      "default": false,
      "description": "When true, this core is flagged for listing on the Wix online store (used parts section). Toggling on pushes the listing to Wix; toggling off removes it."
    },
    "online_title": {
      "type": "string",
      "description": "Title used for the online listing (defaults to core name if blank)"
    },
    "online_description": {
      "type": "string",
      "description": "Description shown on the online listing (defaults to core description if blank)"
    },
    "online_price": {
      "type": "number",
      "description": "Listing price for the online store (defaults to sell_price if blank)"
    },
    "wix_product_id": {
      "type": "string",
      "description": "Wix Stores product ID assigned when the core was pushed to the online catalog"
    },
    "wix_listing_status": {
      "type": "string",
      "enum": [
        "not_listed",
        "pending",
        "listed",
        "error",
        "removed"
      ],
      "default": "not_listed",
      "description": "Current state of the Wix online listing"
    },
    "wix_listed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the core was last successfully pushed to Wix Stores"
    },
    "wix_sync_error": {
      "type": "string",
      "description": "Safe error message from the last failed Wix sync attempt"
    }
  },
  "required": [
    "core_number",
    "name"
  ]
}