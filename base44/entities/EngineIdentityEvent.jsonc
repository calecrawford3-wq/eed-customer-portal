{
  "name": "EngineIdentityEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "component_scanned",
        "pair_verified",
        "pair_changed",
        "location_moved",
        "tag_replaced",
        "qc_verification",
        "lifecycle_changed",
        "retired",
        "reactivated",
        "core_inventory_added",
        "core_inventory_removed",
        "verification_invalidated",
        "unknown_tag_created"
      ]
    },
    "customer_engine_id": {
      "type": "string"
    },
    "component_id": {
      "type": "string"
    },
    "component_code": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "event_key": {
      "type": "string",
      "description": "Stable dedupe key for repeated equivalent events."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  },
  "required": [
    "event_type",
    "occurred_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
