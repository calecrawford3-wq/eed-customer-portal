{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique settings key, e.g. 'global'"
    },
    "company_name": {
      "type": "string"
    },
    "company_address": {
      "type": "string"
    },
    "company_city": {
      "type": "string"
    },
    "company_state": {
      "type": "string"
    },
    "company_zip": {
      "type": "string"
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_website": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "default_payment_terms": {
      "type": "string"
    },
    "invoice_notes_template": {
      "type": "string"
    },
    "estimate_notes_template": {
      "type": "string"
    },
    "po_notes_template": {
      "type": "string"
    },
    "email_from_name": {
      "type": "string"
    },
    "email_from_address": {
      "type": "string"
    },
    "email_signature": {
      "type": "string"
    },
    "smtp_host": {
      "type": "string",
      "description": "SMTP host for general emails (e.g. noreply)"
    },
    "smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP port for general emails"
    },
    "smtp_username": {
      "type": "string",
      "description": "SMTP username for general emails"
    },
    "smtp_password": {
      "type": "string",
      "description": "SMTP password for general emails"
    },
    "smtp_from_name": {
      "type": "string",
      "description": "Display name for general outgoing emails"
    },
    "smtp_from_email": {
      "type": "string",
      "description": "From address for general outgoing emails (e.g. noreply@yourdomain.com)"
    },
    "custom_from_email": {
      "type": "string",
      "description": "Additional 'From' address offered in the email composer (e.g. a personal address like cale@eedpower.com). Must be a verified sender alias in the connected Zoho Mail account."
    },
    "po_smtp_host": {
      "type": "string",
      "description": "SMTP host for purchase order emails"
    },
    "po_smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP port for purchase order emails"
    },
    "po_smtp_username": {
      "type": "string",
      "description": "SMTP username for purchase order emails"
    },
    "po_smtp_password": {
      "type": "string",
      "description": "SMTP password for purchase order emails"
    },
    "po_smtp_from_name": {
      "type": "string",
      "description": "Display name for purchase order outgoing emails"
    },
    "po_smtp_from_email": {
      "type": "string",
      "description": "From address for purchase order emails"
    },
    "zoho_mail_refresh_token": {
      "type": "string",
      "description": "Zoho Mail OAuth refresh token (with Mail read+send scopes) \u2014 generated via the Connect Zoho Mail flow on the Emails page."
    },
    "admin_override_password": {
      "type": "string",
      "description": "Admin password to bypass barcode verification for engine build edits and pickup. If empty, any non-empty input bypasses."
    }
  },
  "required": [
    "key"
  ]
}