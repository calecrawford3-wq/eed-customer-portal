{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique settings key, e.g. 'global'"
    },
    "company_name": {
      "type": "string"
    },
    "company_address": {
      "type": "string"
    },
    "company_city": {
      "type": "string"
    },
    "company_state": {
      "type": "string"
    },
    "company_zip": {
      "type": "string"
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_website": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "default_payment_terms": {
      "type": "string"
    },
    "invoice_notes_template": {
      "type": "string"
    },
    "estimate_notes_template": {
      "type": "string"
    },
    "po_notes_template": {
      "type": "string"
    },
    "email_from_name": {
      "type": "string"
    },
    "email_from_address": {
      "type": "string"
    },
    "email_signature": {
      "type": "string"
    },
    "smtp_host": {
      "type": "string",
      "description": "SMTP host for general emails (e.g. noreply)"
    },
    "smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP port for general emails"
    },
    "smtp_username": {
      "type": "string",
      "description": "SMTP username for general emails"
    },
    "smtp_password": {
      "type": "string",
      "description": "SMTP password for general emails"
    },
    "smtp_from_name": {
      "type": "string",
      "description": "Display name for general outgoing emails"
    },
    "smtp_from_email": {
      "type": "string",
      "description": "From address for general outgoing emails (e.g. noreply@yourdomain.com)"
    },
    "custom_from_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "Additional 'From' addresses offered in the email composer (e.g. a personal address like cale@eedpower.com). Each must be a verified sender address in the connected Zoho Mail account (Settings \u2192 Send Mail As)."
    },
    "po_smtp_host": {
      "type": "string",
      "description": "SMTP host for purchase order emails"
    },
    "po_smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP port for purchase order emails"
    },
    "po_smtp_username": {
      "type": "string",
      "description": "SMTP username for purchase order emails"
    },
    "po_smtp_password": {
      "type": "string",
      "description": "SMTP password for purchase order emails"
    },
    "po_smtp_from_name": {
      "type": "string",
      "description": "Display name for purchase order outgoing emails"
    },
    "po_smtp_from_email": {
      "type": "string",
      "description": "From address for purchase order emails"
    },
    "zoho_mail_refresh_token": {
      "type": "string",
      "description": "DEPRECATED \u2014 migrated to the admin-only EmailCredential entity. Kept only so a one-time migration can copy any legacy token into EmailCredential and then clear it here."
    },
    "email_sync_lock": {
      "type": "string",
      "description": "JSON lock string ({job_id, locked_at}) used to prevent overlapping Zoho Mail sync jobs. Cleared when a sync finishes."
    },
    "email_sync_checkpoints": {
      "type": "string",
      "description": "JSON map of incremental sync checkpoints keyed by accountId|folderId, each {last_message_time, last_message_id}. Lets the sync skip folders whose newest message is not newer than the last sync. Cleared by a full resync."
    },
    "recent_send_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recent client-generated send IDs (max 100) used for idempotent email sending \u2014 prevents duplicate sends on retries."
    },
    "email_notify_quiet_hours": {
      "type": "string",
      "description": "JSON {enabled, start, end} for push-notification quiet hours in shop local time (America/Chicago). When active, new-email push alerts are suppressed during this window."
    },
    "email_notify_on_full_resync": {
      "type": "boolean",
      "default": false,
      "description": "If true, push alerts fire for old emails pulled during a full historical resync. Default false (suppressed) so a resync doesn't spam admins with old mail."
    },
    "admin_override_password": {
      "type": "string",
      "description": "Admin password to bypass barcode verification for engine build edits and pickup. If empty, any non-empty input bypasses."
    }
  },
  "required": [
    "key"
  ]
}