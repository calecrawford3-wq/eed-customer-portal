{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique settings key, e.g. 'global'"
    },
    "company_name": {
      "type": "string"
    },
    "company_address": {
      "type": "string"
    },
    "company_city": {
      "type": "string"
    },
    "company_state": {
      "type": "string"
    },
    "company_zip": {
      "type": "string"
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_website": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "default_payment_terms": {
      "type": "string"
    },
    "invoice_notes_template": {
      "type": "string"
    },
    "estimate_notes_template": {
      "type": "string"
    },
    "po_notes_template": {
      "type": "string"
    },
    "email_from_name": {
      "type": "string"
    },
    "email_from_address": {
      "type": "string"
    },
    "email_signature": {
      "type": "string"
    },
    "smtp_host": {
      "type": "string",
      "description": "SMTP host for general emails (e.g. noreply)"
    },
    "smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP port for general emails"
    },
    "smtp_username": {
      "type": "string",
      "description": "SMTP username for general emails"
    },
    "smtp_password": {
      "type": "string",
      "description": "SMTP password for general emails"
    },
    "smtp_from_name": {
      "type": "string",
      "description": "Display name for general outgoing emails"
    },
    "smtp_from_email": {
      "type": "string",
      "description": "From address for general outgoing emails (e.g. noreply@yourdomain.com)"
    },
    "custom_from_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "Additional 'From' addresses offered in the email composer (e.g. a personal address like cale@eedpower.com). Each must be a verified sender address in the connected Zoho Mail account (Settings \u2192 Send Mail As)."
    },
    "po_smtp_host": {
      "type": "string",
      "description": "SMTP host for purchase order emails"
    },
    "po_smtp_port": {
      "type": "number",
      "default": 587,
      "description": "SMTP port for purchase order emails"
    },
    "po_smtp_username": {
      "type": "string",
      "description": "SMTP username for purchase order emails"
    },
    "po_smtp_password": {
      "type": "string",
      "description": "SMTP password for purchase order emails"
    },
    "po_smtp_from_name": {
      "type": "string",
      "description": "Display name for purchase order outgoing emails"
    },
    "po_smtp_from_email": {
      "type": "string",
      "description": "From address for purchase order emails"
    },
    "zoho_mail_refresh_token": {
      "type": "string",
      "description": "DEPRECATED \u2014 migrated to the admin-only EmailCredential entity. Kept only so a one-time migration can copy any legacy token into EmailCredential and then clear it here."
    },
    "email_sync_lock": {
      "type": "string",
      "description": "JSON lock string ({job_id, locked_at}) used to prevent overlapping Zoho Mail sync jobs. Cleared when a sync finishes."
    },
    "email_sync_checkpoints": {
      "type": "string",
      "description": "JSON map of incremental sync checkpoints keyed by accountId|folderId, each {last_message_time, last_message_id}. Lets the sync skip folders whose newest message is not newer than the last sync. Cleared by a full resync."
    },
    "recent_send_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recent client-generated send IDs (max 100) used for idempotent email sending \u2014 prevents duplicate sends on retries."
    },
    "email_notify_quiet_hours": {
      "type": "string",
      "description": "JSON {enabled, start, end} for push-notification quiet hours in shop local time (America/Chicago). When active, new-email push alerts are suppressed during this window."
    },
    "email_notify_on_full_resync": {
      "type": "boolean",
      "default": false,
      "description": "If true, push alerts fire for old emails pulled during a full historical resync. Default false (suppressed) so a resync doesn't spam admins with old mail."
    },
    "admin_override_password": {
      "type": "string",
      "description": "Admin password to bypass barcode verification for engine build edits and pickup. If empty, any non-empty input bypasses."
    },
    "notif_estimate_accepted": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for accepted estimates"
    },
    "notif_payment_received": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for received payments"
    },
    "notif_po_accepted": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for acknowledged purchase orders"
    },
    "notif_po_ready": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for ready purchase orders"
    },
    "notif_refresh_request": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for engine refresh requests"
    },
    "notif_build_status_change": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for build status changes (complete/shipped)"
    },
    "notif_low_stock": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for low-stock part alerts"
    },
    "notif_email_action_required": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for emails marked as action required"
    },
    "notif_invoice_overdue": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for overdue invoices"
    },
    "notif_engine_pickup_ready": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses in-app notifications for engine pickup confirmations"
    },
    "notif_push_estimate_accepted": {
      "type": "boolean",
      "default": false,
      "description": "When false, suppresses push notifications for accepted estimates (in-app bell still fires if in-app toggle is on)"
    },
    "notif_push_payment_received": {
      "type": "boolean",
      "default": false,
      "description": "When false, suppresses push notifications for received payments"
    },
    "notif_push_po_accepted": {
      "type": "boolean",
      "default": false,
      "description": "When false, suppresses push notifications for acknowledged purchase orders"
    },
    "notif_push_po_ready": {
      "type": "boolean",
      "default": false,
      "description": "When false, suppresses push notifications for ready purchase orders"
    },
    "notif_push_refresh_request": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses push notifications for engine refresh requests"
    },
    "notif_push_build_status_change": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses push notifications for build status changes"
    },
    "notif_push_low_stock": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses push notifications for low-stock alerts"
    },
    "notif_push_email_action_required": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses push notifications for action-required emails"
    },
    "notif_push_invoice_overdue": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses push notifications for overdue invoices"
    },
    "notif_push_engine_pickup_ready": {
      "type": "boolean",
      "default": true,
      "description": "When false, suppresses push notifications for engine pickup confirmations"
    },
    "notif_sound_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, a short chime plays when a new notification arrives in real time while the app is open"
    },
    "voipms_pb_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for VoIP.ms Phone Book synchronization"
    },
    "voipms_pb_default_group": {
      "type": "string",
      "description": "Default VoIP.ms Phone Book group name for new entries",
      "default": "Base44"
    },
    "voipms_pb_prefer_business_name": {
      "type": "boolean",
      "default": true,
      "description": "When true, use the company/business name as the caller-ID name when available"
    },
    "voipms_pb_remove_inactive": {
      "type": "boolean",
      "default": false,
      "description": "When true, remove the VoIP.ms Phone Book entry when a customer is deleted or marked inactive"
    },
    "voipms_pb_nightly_reconciliation": {
      "type": "boolean",
      "default": true,
      "description": "When true, run a nightly reconciliation comparing all customer numbers against the VoIP.ms Phone Book"
    },
    "voipms_pb_last_successful_sync": {
      "type": "string",
      "format": "date-time",
      "description": "When the last successful sync operation completed"
    },
    "voipms_pb_last_full_reconciliation": {
      "type": "string",
      "format": "date-time",
      "description": "When the last full nightly reconciliation completed"
    },
    "voipms_pb_current_sync_status": {
      "type": "string",
      "description": "Current sync status text shown on the settings page (e.g. 'Syncing 45 customers\u2026', 'Idle', 'Last sync failed')"
    },
    "facebook_page_id": {
      "type": "string",
      "description": "Selected Facebook Page ID for Messenger integration"
    },
    "facebook_page_name": {
      "type": "string",
      "description": "Selected Facebook Page name for Messenger integration"
    },
    "facebook_last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "When Facebook Messenger messages were last synced"
    },
    "facebook_page_access_token": {
      "type": "string",
      "description": "Cached long-lived Facebook Page access token (obtained via token exchange). Used by scheduled syncs that have no user context."
    },
    "facebook_page_token_cached_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cached Facebook Page access token was last refreshed"
    }
  },
  "required": [
    "key"
  ]
}