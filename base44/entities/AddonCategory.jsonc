{
  "name": "AddonCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name (e.g. Yamaha, Suzuki, Honda)"
    },
    "description": {
      "type": "string",
      "description": "Optional description shown in the picker"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}