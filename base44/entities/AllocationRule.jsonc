{
  "name": "AllocationRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "target_account_id": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed",
        "purchasing_cost",
        "monthly_target"
      ]
    },
    "value": {
      "type": "number"
    },
    "priority": {
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "minimum_balance": {
      "type": "number",
      "default": 0,
      "description": "Optional minimum balance to retain in dollars"
    },
    "allow_savings_backup": {
      "type": "boolean",
      "default": false,
      "description": "When receiving funds are insufficient, use Savings to fill this target; enable only for essential obligations"
    }
  },
  "required": [
    "name",
    "target_account_id",
    "rule_type"
  ]
}