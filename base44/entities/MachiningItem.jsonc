{
  "name": "MachiningItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Machining item name (e.g. Bore & Hone, Head Surface, Line Hone)"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the machining operation"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "Standard price for this machining operation"
    },
    "category": {
      "type": "string",
      "enum": [
        "block",
        "head",
        "rotating_assembly",
        "valvetrain",
        "other"
      ],
      "default": "other",
      "description": "Machining category"
    },
    "cost_type": {
      "type": "string",
      "enum": [
        "unspecified",
        "in_house",
        "outsourced"
      ],
      "default": "unspecified",
      "description": "Default cost tracking for this operation. in_house = performed in-shop (cost covered by logged labor hours); outsourced = sent to an external vendor (actual vendor cost recorded per job); unspecified = not yet classified. Carried to estimates/invoices as the default so it doesn't need to be set each time."
    },
    "default_vendor": {
      "type": "string",
      "description": "Default vendor name for outsourced operations (optional). Pre-fills the vendor field when this item is added to an estimate/invoice."
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "price"
  ]
}