{
  "name": "CustomerSuccessTask",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "engine_serial_number": {
      "type": "string"
    },
    "eed_id": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "3_5_days",
        "2_weeks",
        "1_month",
        "3_months",
        "6_months",
        "9_months",
        "12_months",
        "custom"
      ],
      "default": "custom"
    },
    "title": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "call_time": {
      "type": "string",
      "description": "Optional time-of-day for the follow-up call (HH:MM). Blank = any time / all day"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "skipped"
      ],
      "default": "pending"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "checked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "satisfaction": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "needs_attention",
        "problem"
      ]
    },
    "requires_followup": {
      "type": "boolean",
      "default": false
    },
    "followup_date": {
      "type": "string",
      "format": "date"
    },
    "followup_task_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    },
    "assigned_user_id": {
      "type": "string",
      "description": "Staff member assigned to this task"
    },
    "source_email_id": {
      "type": "string",
      "description": "Email record this task was created from (email-to-task conversion)"
    },
    "source_email_subject": {
      "type": "string",
      "description": "Subject of the source email, captured for display"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "contact_method": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "due_date",
    "timeframe",
    "title"
  ]
}