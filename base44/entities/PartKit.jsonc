{
  "name": "PartKit",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string",
      "description": "Kit part number / SKU (e.g. COMETIC-KIT-GSX600)"
    },
    "name": {
      "type": "string",
      "description": "Kit display name"
    },
    "description": {
      "type": "string",
      "description": "What this kit groups together and why"
    },
    "category": {
      "type": "string",
      "enum": [
        "block",
        "rotating_assembly",
        "cylinder_head",
        "valvetrain",
        "timing",
        "oiling",
        "fasteners",
        "gaskets",
        "seals",
        "electrical",
        "other"
      ],
      "default": "other"
    },
    "supplier_id": {
      "type": "string",
      "description": "Vendor / supplier this kit is ordered from"
    },
    "components": {
      "type": "array",
      "description": "Individual parts that make up this kit. When added as separate items, each component is listed as its own line item; when added as a single item, components are bundled but still populate purchase orders.",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_cost": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "description": "Labor included in this kit (e.g. assembly labor bundled into a transmission kit). When added as separate items, these become labor lines; when added as a single item, their price is bundled into the kit line.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "default_display_mode": {
      "type": "string",
      "enum": [
        "separate",
        "whole"
      ],
      "default": "separate",
      "description": "How this kit is added to documents by default: 'separate' = each component and labor line listed individually; 'whole' = single line under the kit name (components still populate purchase orders)"
    },
    "kit_cost_override": {
      "type": "number",
      "description": "Optional manual kit cost override. When set, used instead of the summed component cost."
    },
    "kit_price_override": {
      "type": "number",
      "description": "Optional manual kit sell price override. When set, used instead of the summed component + labor price."
    },
    "platform_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Compatible engine platform IDs"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "part_number",
    "name"
  ]
}