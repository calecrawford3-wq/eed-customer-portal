{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "description": "Push service endpoint URL for this device/browser"
    },
    "p256dh_key": {
      "type": "string",
      "description": "Subscriber P-256 public key (base64) for payload encryption"
    },
    "auth_key": {
      "type": "string",
      "description": "Subscriber auth secret (base64) for payload encryption"
    },
    "user_id": {
      "type": "string",
      "description": "User who registered this subscription"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser/device identifier for debugging"
    }
  },
  "required": [
    "endpoint",
    "p256dh_key",
    "auth_key"
  ]
}