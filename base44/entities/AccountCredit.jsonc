{
  "name": "AccountCredit",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Customer who owns this credit"
    },
    "amount": {
      "type": "number",
      "description": "Positive = credit earned, negative = credit redeemed/applied"
    },
    "type": {
      "type": "string",
      "enum": [
        "performance",
        "referral",
        "manual",
        "redemption",
        "other"
      ],
      "default": "manual",
      "description": "Credit category"
    },
    "subtype": {
      "type": "string",
      "description": "e.g. '1st Place', 'Heat Race Win', 'Referral Bonus'"
    },
    "description": {
      "type": "string"
    },
    "source_reference": {
      "type": "string",
      "description": "e.g. referrer customer ID or race result reference"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "expires_on": {
      "type": "string",
      "format": "date",
      "description": "Expiration date (Dec 31 of year earned for performance credits)"
    },
    "linked_estimate_id": {
      "type": "string",
      "description": "Estimate this credit was redeemed against"
    },
    "linked_invoice_id": {
      "type": "string",
      "description": "Invoice this credit was redeemed against"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "redeemed"
      ],
      "default": "active"
    },
    "pending_reason": {
      "type": "string",
      "description": "Why a credit is pending and what event releases it."
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a pending credit became active."
    },
    "source_result_id": {
      "type": "string",
      "description": "RaceResult ID when a performance credit was generated automatically."
    }
  },
  "required": [
    "customer_id",
    "amount",
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
