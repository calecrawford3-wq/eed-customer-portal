{
  "name": "Addon",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Addon name (e.g. 'Port & Polish', 'Billet Cam')"
    },
    "description": {
      "type": "string",
      "description": "Short description shown in the estimate picker"
    },
    "category_id": {
      "type": "string",
      "description": "AddonCategory this addon belongs to"
    },
    "category_name": {
      "type": "string",
      "description": "Denormalized category name for display"
    },
    "line_items": {
      "type": "array",
      "description": "Parts included in this addon (references to inventory, no pricing stored \u2014 pulled at add time)",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "labor_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "machining_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "price_override": {
      "type": "number",
      "description": "Optional flat price for the addon. If set, used instead of summing current inventory prices when added to an estimate."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}