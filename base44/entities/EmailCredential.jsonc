{
  "name": "EmailCredential",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Credential identifier, e.g. 'zoho_mail'"
    },
    "refresh_token": {
      "type": "string",
      "description": "OAuth refresh token. Stored here (admin-only via RLS) instead of AppSettings so non-admin app users cannot read it."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}