{
  "name": "CustomerEngine",
  "type": "object",
  "properties": {
    "eed_id": {
      "type": "string",
      "description": "Unique EED ID (e.g. EED1040) \u2014 linked to one engine serial number"
    },
    "engine_serial_number": {
      "type": "string",
      "description": "Physical engine serial number"
    },
    "customer_id": {
      "type": "string",
      "description": "Owning customer"
    },
    "platform_id": {
      "type": "string",
      "description": "Engine platform"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "stock",
        "stage_1",
        "stage_2",
        "stage_3",
        "contract",
        "custom"
      ],
      "description": "Current build stage assigned to this engine \u2014 updated automatically when a build is marked complete"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "eed_id",
    "engine_serial_number",
    "customer_id",
    "platform_id"
  ]
}