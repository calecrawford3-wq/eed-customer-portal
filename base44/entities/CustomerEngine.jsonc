{
  "name": "CustomerEngine",
  "type": "object",
  "properties": {
    "eed_id": {
      "type": "string",
      "description": "Unique EED ID (e.g. EED1040) \u2014 linked to one engine serial number"
    },
    "engine_serial_number": {
      "type": "string",
      "description": "Physical engine serial number"
    },
    "customer_id": {
      "type": "string",
      "description": "Owning customer"
    },
    "platform_id": {
      "type": "string",
      "description": "Engine platform"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "stock",
        "stage_1",
        "stage_2",
        "stage_3",
        "contract",
        "custom"
      ],
      "description": "Current build stage assigned to this engine \u2014 updated automatically when a build is marked complete"
    },
    "check_in_status": {
      "type": "string",
      "enum": [
        "not_checked_in",
        "checked_in",
        "estimate_pending",
        "in_build",
        "build_complete",
        "picked_up"
      ],
      "default": "not_checked_in",
      "description": "Pre-build and post-build lifecycle status tracking"
    },
    "storage_location": {
      "type": "string",
      "description": "Physical storage location where this engine is kept in the shop"
    },
    "check_in_date": {
      "type": "string",
      "format": "date",
      "description": "Date the engine was checked in at the shop"
    },
    "picked_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the engine was picked up by the customer (final pickup scan confirmed)"
    },
    "notes": {
      "type": "string"
    },
    "tag_code": {
      "type": "string",
      "description": "Immutable internal scan code laser-engraved on the case/bottom-end identity tag."
    },
    "current_head_component_id": {
      "type": "string",
      "description": "Currently paired EngineComponent record for the cylinder head."
    },
    "identity_initialized_at": {
      "type": "string",
      "format": "date-time",
      "description": "When permanent engine/component tag identities were initialized."
    },
    "current_case_component_id": {
      "type": "string",
      "description": "Serialized EngineComponent record for the physical engine case/bottom end currently representing this engine."
    },
    "current_tag_version_id": {
      "type": "string"
    },
    "verification_invalidated_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_invalidation_reason": {
      "type": "string"
    }
  },
  "required": [
    "eed_id",
    "engine_serial_number",
    "customer_id",
    "platform_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
