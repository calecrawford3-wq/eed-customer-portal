{
  "name": "CustomerEngine",
  "type": "object",
  "properties": {
    "eed_id": {
      "type": "string",
      "description": "Unique EED ID (e.g. EED1040) \u2014 linked to one engine serial number"
    },
    "engine_serial_number": {
      "type": "string",
      "description": "Physical engine serial number"
    },
    "customer_id": {
      "type": "string",
      "description": "Owning customer"
    },
    "platform_id": {
      "type": "string",
      "description": "Engine platform"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "stock",
        "stage_1",
        "stage_2",
        "stage_3",
        "contract",
        "custom"
      ],
      "description": "Current build stage assigned to this engine \u2014 updated automatically when a build is marked complete"
    },
    "check_in_status": {
      "type": "string",
      "enum": [
        "not_checked_in",
        "checked_in",
        "estimate_pending",
        "in_build",
        "build_complete",
        "picked_up"
      ],
      "default": "not_checked_in",
      "description": "Pre-build and post-build lifecycle status tracking: checked_in = dropped off at shop; estimate_pending = estimate in progress; in_build = active build exists; build_complete = build finished, awaiting pickup; picked_up = customer picked up"
    },
    "storage_location": {
      "type": "string",
      "description": "Physical storage location where this engine is kept in the shop (e.g., Cart 1, Tote 3, Rack A-3)"
    },
    "check_in_date": {
      "type": "string",
      "format": "date",
      "description": "Date the engine was checked in at the shop"
    },
    "picked_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the engine was picked up by the customer (final pickup scan confirmed)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "eed_id",
    "engine_serial_number",
    "customer_id",
    "platform_id"
  ]
}