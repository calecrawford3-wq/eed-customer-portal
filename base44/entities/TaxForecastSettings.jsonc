{
  "name": "TaxForecastSettings",
  "type": "object",
  "properties": {
    "tax_year": {
      "type": "integer"
    },
    "federal_effective_rate": {
      "type": "number"
    },
    "state_effective_rate": {
      "type": "number"
    },
    "other_household_taxable_income": {
      "type": "number"
    },
    "deduction_adjustment": {
      "type": "number"
    },
    "tax_payments_made": {
      "type": "number"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tax_year"
  ]
}