{
  "name": "AdditionalWork",
  "type": "object",
  "properties": {
    "work_number": {
      "type": "string",
      "description": "Stable identifier (e.g. AW-0001)"
    },
    "job_id": {
      "type": "string",
      "description": "Linked Job"
    },
    "customer_id": {
      "type": "string",
      "description": "Denormalized from the job"
    },
    "customer_engine_id": {
      "type": "string",
      "description": "Denormalized from the job"
    },
    "title": {
      "type": "string",
      "description": "Short title for the additional work request"
    },
    "description": {
      "type": "string",
      "description": "Summary shown to the customer"
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "TeardownFinding records included in this request"
    },
    "line_items": {
      "type": "array",
      "description": "Parts aggregated from included findings",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "outsourced_services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "canceled"
      ],
      "default": "pending",
      "description": "pending = awaiting approval, approved = approved & applied, declined = rejected, canceled = withdrawn"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Increments on each edit before approval"
    },
    "version_history": {
      "type": "array",
      "default": [],
      "description": "Snapshots of each version with timestamp and reason",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "canceled_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "customer_note": {
      "type": "string",
      "description": "Customer's response note (approval or decline reason)"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When approved work was applied to reservations, invoice, and tasks. Idempotency guard \u2014 applied exactly once."
    },
    "invoice_id": {
      "type": "string",
      "description": "Invoice that received the approved additional work line items"
    },
    "reservation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "public_access_token": {
      "type": "string",
      "description": "Token for customer portal approval of additional work"
    }
  },
  "required": [
    "work_number",
    "job_id"
  ]
}