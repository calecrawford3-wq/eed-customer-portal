{
  "name": "Customer",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary email address (used for portal invites and statements)"
    },
    "additional_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "Extra email addresses for this customer (auto-matched against inbound/outbound emails)"
    },
    "phone": {
      "type": "string"
    },
    "additional_phones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra phone numbers for this customer (each synced to the VoIP.ms Phone Book as its own entry)"
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "Customer country"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "tax_exempt": {
      "type": "boolean",
      "default": false,
      "description": "If true, no sales tax is charged on this customer's estimates/invoices"
    },
    "parts_markup_override": {
      "type": "number",
      "description": "Override markup percentage applied to part costs for this customer (e.g. 10 = 10%). Leave null/undefined to use each part's own markup."
    },
    "portal_temp_password": {
      "type": "string",
      "description": "Temporary password for customer portal access"
    },
    "portal_invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "True once the customer has been sent a portal invite (automatically on their first completed engine build). Prevents duplicate invites on subsequent builds."
    },
    "portal_invite_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the portal invite was first sent to this customer"
    },
    "voipms_phonebook_id": {
      "type": "string",
      "description": "VoIP.ms Phone Book entry ID for the primary phone (backward compat \u2014 VoipmsPhoneEntry entity is the source of truth for all numbers)"
    },
    "voipms_sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "synced",
        "error",
        "skipped"
      ],
      "default": "pending",
      "description": "Current VoIP.ms Phone Book sync state for the primary phone"
    },
    "voipms_last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer was last successfully synced to the VoIP.ms Phone Book"
    },
    "voipms_sync_error": {
      "type": "string",
      "description": "Safe error message from the last failed sync attempt (no credentials)"
    },
    "voipms_synced_name": {
      "type": "string",
      "description": "Display name that was last written to the VoIP.ms Phone Book"
    },
    "voipms_synced_phone": {
      "type": "string",
      "description": "Normalized phone number that was last written to the VoIP.ms Phone Book"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}