{
  "name": "EmailSyncLog",
  "type": "object",
  "properties": {
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "skipped"
      ],
      "default": "success"
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "accounts": {
      "type": "number",
      "default": 0
    },
    "messages_found": {
      "type": "number",
      "default": 0
    },
    "messages_created": {
      "type": "number",
      "default": 0
    },
    "threads_created": {
      "type": "number",
      "default": 0
    },
    "threads_updated": {
      "type": "number",
      "default": 0
    },
    "links_created": {
      "type": "number",
      "default": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled",
        "sync",
        "send"
      ],
      "default": "manual"
    }
  },
  "required": [
    "status"
  ]
}