{
  "name": "EngineAssistanceOffer",
  "type": "object",
  "properties": {
    "acorn_notice_claim":{"type":"string","description":"Atomic claim for the latest Acorn status notification."},
    "acorn_status_notice_claims":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string"},"claim":{"type":"string"}}}},
    "acorn_reference":{"type":"string","description":"Opaque Acorn postback correlation reference"},
    "acorn_financing_history":{"type":"array","items":{"type":"object"},"description":"Prior Acorn financing requests for earlier balances; staff audit only."},
    "acorn_financing":{"type":"object","properties":{
      "reference":{"type":"string"},"amount_cents":{"type":"number"},"started_at":{"type":"string"},
      "status":{"type":"string","enum":["opened","offers_received","approved","no_offers","funded","pending","no_suitable_offers","insufficient_amount","not_completed","technical_issue"]},
      "status_source":{"type":"string"},"status_at":{"type":"string"},
      "application_reference":{"type":"string"},"evidence":{"type":"string"},
      "customer_review":{"type":"string"},"customer_review_at":{"type":"string"}
    }},
    "lender_option_review": {
      "type":"object",
      "properties":{
        "amount_cents":{"type":"number"},
        "reviewed_at":{"type":"string"},
        "entries":{"type":"array","items":{"type":"object","properties":{
          "lender":{"type":"string"},"outcome":{"type":"string"},
          "approved_amount":{"type":"number"},"apr":{"type":"number"},
          "payment_amount":{"type":"number"},"term_months":{"type":"number"}
        }}}
      }
    },
    "offer_number": {
      "type": "string",
      "description": "Staff-facing offer identifier (EAO-YYYY-####)"
    },
    "application_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "description": "Normal shop job, created only once the offer is paid in full, or the deposit is verified with a signed approved in-house agreement"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "accepted",
        "declined",
        "expired",
        "partially_paid",
        "paid",
        "void"
      ],
      "default": "draft",
      "enumColors": [
        "gray",
        "blue",
        "blue",
        "green",
        "red",
        "yellow",
        "yellow",
        "green",
        "gray"
      ]
    },
    "sunbit_service_confirmed": {"type":"boolean","default":false,"description":"Staff confirmed eligible services have commenced; not for advance deposits or vehicle purchases."},
    "line_items": {
      "type": "array",
      "description": "Parts and kit lines on the assisted build",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_price": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "default": 0
          },
          "quantity": {
            "type": "number",
            "default": 1
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "assistance_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent",
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "assistance_percent": {
      "type": "number",
      "default": 0
    },
    "requested_assistance_amount": {
      "type": "number",
      "default": 0,
      "description": "Fixed assistance dollar amount entered by staff before the fund cap is applied"
    },
    "assistance_amount": {
      "type": "number",
      "default": 0,
      "description": "Assistance applied to this offer after the fund cap"
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Subtotal minus assistance; the engine package price after the award"
    },
    "amount_due": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "pay_in_full_enabled": {
      "type": "boolean",
      "default": true
    },
    "payment_plan": {
      "type": "string",
      "enum": [
        "none",
        "full",
        "deposit_internal"
      ],
      "default": "none",
      "enumColors": [
        "gray",
        "green",
        "purple"
      ],
      "description": "How this offer is being paid: full amount, or a deposit plus Elite in-house financing of the remainder"
    },
    "deposit_percent": {
      "type": "number",
      "default": 50,
      "description": "Required upfront deposit as a percentage of the net balance after assistance (10-90)"
    },
    "deposit_amount": {
      "type": "number",
      "default": 0,
      "description": "Required upfront deposit in dollars"
    },
    "deposit_paid": {
      "type": "number",
      "default": 0
    },
    "deposit_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only once verified or staff-recorded payments cover the required deposit"
    },
    "deposit_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "deposit_method": {
      "type": "string",
      "description": "Payment method that satisfied the deposit (card, us_bank_account, affirm, ...)"
    },
    "deposit_lender": {
      "type": "string",
      "description": "Third-party lender that financed the deposit, when one was used"
    },
    "internal_financed_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount Elite finances in-house after the deposit. Never collected a second time through the offer checkout."
    },
    "internal_loan_id": {
      "type": "string"
    },
    "installments_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Shows lender financing for any balance a lender actually covers; the priority amount is a label only"
    },
    "expires_on": {
      "type": "string",
      "format": "date"
    },
    "terms_text": {
      "type": "string"
    },
    "share_token": {
      "type": "string",
      "description": "Long random token for the customer's private offer page. Never contains PII. Rotatable."
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "payments": {
      "type": "array",
      "description": "Verified payments only. Provider receipts are written by the webhook, never by the browser.",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "us_bank_account",
              "affirm",
              "sunbit",
              "klarna",
              "afterpay_clearpay",
              "financing",
              "manual",
              "other"
            ]
          },
          "provider": {
            "type": "string",
            "description": "Payment provider that verified the payment (stripe) or 'manual' for staff-recorded payments"
          },
          "financed": {
            "type": "boolean",
            "default": false
          },
          "financed_amount": {
            "type": "number",
            "default": 0
          },
          "amount_option": {
            "type": "string",
            "description": "pay_in_full, installment, deposit, deposit_lender or manual"
          },
          "stripe_session_id": {
            "type": "string"
          },
          "stripe_payment_intent": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          }
        }
      }
    },
    "financing_availability": {
      "type": "array",
      "description": "Financing methods Stripe reported as available when this offer was last prepared",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "financing_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "financing_note": {
      "type": "string",
      "description": "Honest statement about what is available. Never an approval or a promised payment term."
    },
    "internal_notes": {
      "type": "string"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "payment_route_claim": {
      "type": "string"
    },
    "payment_route": {
      "type": "string"
    },
    "payment_route_started_at": {
      "type": "string"
    },
    "payment_route_session": {
      "type": "string"
    },
    "payment_route_options": {
      "type": "string"
    }
  },
  "required": [
    "offer_number",
    "application_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
