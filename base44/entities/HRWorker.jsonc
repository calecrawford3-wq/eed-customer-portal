{
  "name": "HRWorker",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "w2",
        "1099"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "inactive"
      ]
    },
    "job_title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "hire_date": {
      "type": "string"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "salary",
        "contract"
      ]
    },
    "pay_rate": {
      "type": "number"
    },
    "benefits_notes": {
      "type": "string"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "employee",
        "shop_staff",
        "manager"
      ]
    },
    "pto_hours_available": {
      "type": "number"
    },
    "emergency_contact": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}