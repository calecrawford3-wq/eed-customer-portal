{
  "name": "HRWorker",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "personal_email": {
      "type": "string",
      "description": "Private personal HR contact email for tax forms, benefits, and employment documents. Not used for authentication or workspace invitations."
    },
    "phone": {
      "type": "string"
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "w2",
        "1099",
        "owner"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "inactive",
        "terminated"
      ]
    },
    "job_title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "hire_date": {
      "type": "string"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "salary",
        "contract"
      ]
    },
    "pay_rate": {
      "type": "number"
    },
    "benefits_notes": {
      "type": "string"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "employee",
        "shop_staff",
        "manager",
        "owner"
      ]
    },
    "ownership_percentage": {
      "type": "number",
      "description": "Recorded legal/economic ownership percentage from 0 to 100. Owner profiles only; does not grant authentication permissions."
    },
    "allowed_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Owner-selected page navigation permissions for active employees. Does not bypass backend entity RLS or authorize sensitive data access."
    },
    "can_view_shop_jobs": {
      "type": "boolean",
      "default": false,
      "description": "Allows restricted shop job work queue only; does not grant admin role or raw entity access."
    },
    "former_employee_invite_sent_at": {
      "type": "string",
      "description": "Tax-only former employee personal-email invitation timestamp."
    },
    "termination_date": {
      "type": "string"
    },
    "portal_invite_sent_at": {
      "type": "string"
    },
    "can_view_build_profitability": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly assigned by the owner; never inferred from job title or manager role."
    },
    "pto_hours_available": {
      "type": "number"
    },
    "emergency_contact": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}