{
  "name": "CallLog",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Linked customer"
    },
    "customer_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string",
      "description": "Which additional contact (CustomerContact) the call was with, when matched"
    },
    "phone_number": {
      "type": "string",
      "description": "Number dialed"
    },
    "direction": {
      "type": "string",
      "enum": [
        "outbound",
        "inbound"
      ],
      "default": "outbound"
    },
    "call_status": {
      "type": "string",
      "enum": [
        "connected",
        "no_answer",
        "voicemail",
        "busy",
        "failed",
        "missed"
      ],
      "description": "Result of the call attempt"
    },
    "outcome": {
      "type": "string",
      "description": "Short outcome summary"
    },
    "notes": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "satisfaction": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "needs_attention",
        "problem"
      ]
    },
    "followup_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "enum": [
        "click_to_call",
        "customer_success",
        "manual",
        "voip_cdr"
      ],
      "default": "click_to_call",
      "description": "Origin of the call log: click_to_call = outbound via desk phone, customer_success = CS follow-up, manual = logged by hand, voip_cdr = auto-imported from VoIP.ms Call Detail Records"
    },
    "related_build_id": {
      "type": "string"
    },
    "related_task_id": {
      "type": "string",
      "description": "Linked CustomerSuccessTask when source=customer_success"
    },
    "via_voip": {
      "type": "boolean",
      "default": false,
      "description": "True when the call was initiated through VoIP.ms click2call (desk phone)"
    },
    "voip_call_id": {
      "type": "string",
      "description": "VoIP.ms CDR callid \u2014 used to dedupe auto-imported inbound calls"
    }
  },
  "required": [
    "customer_id",
    "phone_number"
  ]
}