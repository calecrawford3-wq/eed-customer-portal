{
  "name": "DriverNote",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "preferred_tracks": {
      "type": "string"
    },
    "driving_style": {
      "type": "string"
    },
    "favorite_gearing": {
      "type": "string"
    },
    "championship_goals": {
      "type": "string"
    },
    "family_information": {
      "type": "string"
    },
    "future_plans": {
      "type": "string"
    },
    "upcoming_engine_class": {
      "type": "string"
    },
    "other_notes": {
      "type": "string"
    },
    "preferred_contact_time": {
      "type": "string",
      "description": "Preferred time of day for follow-up calls (e.g. Morning, Afternoon, Evening)"
    },
    "preferred_contact_days": {
      "type": "string",
      "description": "Preferred days of the week for follow-up calls (comma-separated, e.g. Mon,Wed,Fri)"
    }
  },
  "required": [
    "customer_id"
  ]
}