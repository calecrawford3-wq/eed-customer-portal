{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string",
      "description": "Optional: converted from estimate"
    },
    "customer_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string",
      "description": "Optional: linked CustomerEngine record"
    },
    "public_access_token": {
      "type": "string",
      "description": "Secure random token for public viewing without authentication"
    },
    "stripe_checkout_url": {
      "type": "string",
      "description": "Pre-generated Stripe checkout URL for public payments"
    },
    "contains_illegal_parts": {
      "type": "boolean",
      "default": false,
      "description": "If true, this invoice involves illegal parts and requires a signed acknowledgment"
    },
    "is_legacy": {
      "type": "boolean",
      "default": false,
      "description": "True if this invoice was imported from an old system (summary only, no line items)"
    },
    "legacy_pdf_url": {
      "type": "string",
      "description": "URL to the original PDF from the old system, downloadable in the client portal"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partial",
        "paid",
        "overdue",
        "void"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "core_id": {
            "type": "string",
            "description": "Reference to EngineCore when selling a core from inventory"
          },
          "is_core_credit": {
            "type": "boolean",
            "default": false,
            "description": "True when this line is a core credit (customer core bought/exchanged)"
          },
          "core_details": {
            "type": "object",
            "description": "Captured core details for a core credit line, used to add the core to inventory when the invoice completes",
            "properties": {
              "core_number": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "unit_cost": {
                "type": "number"
              },
              "sell_price": {
                "type": "number"
              },
              "core_credit": {
                "type": "number"
              },
              "platform_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "description": "Machining operations charged on this invoice",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "description": "All payment records for this invoice",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "applied_credits": {
      "type": "number",
      "default": 0,
      "description": "Account credits applied to this invoice (Performance Credit System)"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "amount_due": {
      "type": "number"
    },
    "balance_due": {
      "type": "number"
    },
    "payment_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "customer_id"
  ]
}