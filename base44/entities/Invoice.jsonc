{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string",
      "description": "Optional: converted from estimate"
    },
    "customer_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string",
      "description": "Optional: linked CustomerEngine record"
    },
    "public_access_token": {
      "type": "string",
      "description": "Secure random token for public viewing without authentication"
    },
    "stripe_checkout_url": {
      "type": "string",
      "description": "Pre-generated Stripe checkout URL for public payments"
    },
    "due_on_completion": {
      "type": "boolean",
      "default": false,
      "description": "True for engine-build invoices whose remaining balance is not due until the linked build completes. Before completion, display 'Due on build completion' and leave due_date empty. At completion, due_date is set to the completion date (America/Chicago) and this flag is cleared. Standalone parts/service invoices never set this flag."
    },
    "contains_illegal_parts": {
      "type": "boolean",
      "default": false
    },
    "is_combined": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a combined/multi-engine invoice that aggregates items from multiple member invoices (or was built from scratch with multiple engine sections). The customer sees one sectioned invoice; the admin sees per-engine attribution."
    },
    "member_invoice_ids": {
      "type": "array",
      "description": "IDs of the source invoices that were merged into this combined invoice (empty when the combined invoice was built from scratch).",
      "items": {
        "type": "string"
      }
    },
    "combined_parent_id": {
      "type": "string",
      "description": "On a member invoice, points to the combined invoice that absorbed it. Lets the admin navigate from a member to its combined parent."
    },
    "is_legacy": {
      "type": "boolean",
      "default": false
    },
    "legacy_pdf_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partial",
        "paid",
        "overdue",
        "void"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "shipping_cost": {
            "type": "number",
            "default": 0,
            "description": "Per-unit inbound shipping cost captured from the part (landed cost component for profit margin)"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "engine_section": {
            "type": "string",
            "description": "Engine label this line item belongs to on a combined/multi-engine invoice (e.g. 'EED 1040 \u2014 GSX600'). Blank on single-engine invoices."
          },
          "is_kit": {
            "type": "boolean",
            "default": false,
            "description": "True when this line is a bundled kit shown as a single item"
          },
          "kit_id": {
            "type": "string",
            "description": "Reference to the PartKit when is_kit is true"
          },
          "kit_components": {
            "type": "array",
            "description": "Component parts captured from the kit, used to expand into purchase orders",
            "items": {
              "type": "object",
              "properties": {
                "part_id": {
                  "type": "string"
                },
                "part_number": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number",
                  "default": 1
                },
                "unit_cost": {
                  "type": "number"
                }
              }
            }
          },
          "core_id": {
            "type": "string",
            "description": "Reference to EngineCore when selling a core from inventory"
          },
          "is_core_credit": {
            "type": "boolean",
            "default": false
          },
          "core_details": {
            "type": "object",
            "description": "Captured core details for a core credit line",
            "properties": {
              "core_number": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "unit_cost": {
                "type": "number"
              },
              "sell_price": {
                "type": "number"
              },
              "core_credit": {
                "type": "number"
              },
              "platform_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "engine_section": {
            "type": "string",
            "description": "Engine label this labor item belongs to on a combined invoice."
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "description": "Machining operations charged on this invoice",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "engine_section": {
            "type": "string",
            "description": "Engine label this machining item belongs to on a combined invoice."
          },
          "cost_type": {
            "type": "string",
            "enum": [
              "unspecified",
              "in_house",
              "outsourced"
            ],
            "default": "unspecified",
            "description": "How this machining operation's actual cost is tracked. in_house = covered by logged labor hours (no separate vendor cost); outsourced = performed by an external vendor with an actual cost; unspecified = not yet classified (flagged in profitability)."
          },
          "actual_cost": {
            "type": "number",
            "description": "Actual vendor cost for outsourced machining. Null/absent = cost not yet recorded (flagged as missing in profitability). Explicitly 0 = vendor did the work at no charge (not flagged). Never use the customer price as the actual cost."
          },
          "vendor": {
            "type": "string",
            "description": "Vendor name for outsourced machining (optional)"
          },
          "expense_id": {
            "type": "string",
            "description": "Optional link to an Expense record for the vendor bill, when the cost was recorded as a job expense"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "description": "All payment records for this invoice",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "none",
        "amount",
        "percentage"
      ],
      "default": "none"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Shipping charge added to the total"
    },
    "applied_credits": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "amount_due": {
      "type": "number"
    },
    "balance_due": {
      "type": "number"
    },
    "first_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "payment_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "customer_id"
  ]
}