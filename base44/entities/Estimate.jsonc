{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string",
      "description": "Optional: linked CustomerEngine record"
    },
    "build_id": {
      "type": "string",
      "description": "Optional linked engine build"
    },
    "invoice_id": {
      "type": "string",
      "description": "Optional linked invoice (when converted)"
    },
    "spec_sheet_id": {
      "type": "string",
      "description": "Spec sheet used for this estimate (set when canned job is loaded)"
    },
    "is_engine_build": {
      "type": "boolean",
      "default": false,
      "description": "If true, approval creates an engine build. If false, approval creates an invoice."
    },
    "contains_illegal_parts": {
      "type": "boolean",
      "default": false,
      "description": "If true, customer must sign an Illegal Parts Acknowledgment"
    },
    "contains_contract_engine": {
      "type": "boolean",
      "default": false,
      "description": "If true, a Contract Engine IP & Seal agreement has been generated for this estimate"
    },
    "public_access_token": {
      "type": "string",
      "description": "Secure random token for public viewing without authentication"
    },
    "stripe_checkout_url": {
      "type": "string",
      "description": "Pre-generated Stripe checkout URL for public deposit/payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "expired"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "deposit_required": {
      "type": "boolean",
      "default": false
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "shipping_cost": {
            "type": "number",
            "default": 0,
            "description": "Per-unit inbound shipping cost captured from the part (landed cost component for profit margin)"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "is_kit": {
            "type": "boolean",
            "default": false,
            "description": "True when this line is a bundled kit shown as a single item"
          },
          "kit_id": {
            "type": "string",
            "description": "Reference to the PartKit when is_kit is true"
          },
          "kit_components": {
            "type": "array",
            "description": "Component parts captured from the kit, used to expand into purchase orders",
            "items": {
              "type": "object",
              "properties": {
                "part_id": {
                  "type": "string"
                },
                "part_number": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number",
                  "default": 1
                },
                "unit_cost": {
                  "type": "number"
                }
              }
            }
          },
          "core_id": {
            "type": "string",
            "description": "Reference to EngineCore when selling a core from inventory"
          },
          "is_core_credit": {
            "type": "boolean",
            "default": false
          },
          "core_details": {
            "type": "object",
            "properties": {
              "core_number": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "unit_cost": {
                "type": "number"
              },
              "sell_price": {
                "type": "number"
              },
              "core_credit": {
                "type": "number"
              },
              "platform_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "description": "Machining operations on this estimate",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "none",
        "amount",
        "percentage"
      ],
      "default": "none"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Shipping charge added to the total"
    },
    "applied_credits": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "amount_due": {
      "type": "number"
    },
    "first_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "comparison_group_id": {
      "type": "string",
      "description": "Shared ID linking estimates in a stage comparison group (empty when not part of a comparison)"
    },
    "comparison_stage_label": {
      "type": "string",
      "description": "Display label for this estimate within its comparison group (e.g. 'Stage 1', 'Stage 2')"
    },
    "comparison_sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sort position within the comparison group (1 = first stage)"
    },
    "comparison_public_token": {
      "type": "string",
      "description": "Shared public token for the comparison group \u2014 the viewer uses this to fetch all stages at once"
    },
    "comparison_ai_summary": {
      "type": "string",
      "description": "Denormalized AI-generated summary of differences and per-stage benefits (same text stored on every estimate in the group)"
    },
    "comparison_choice": {
      "type": "string",
      "enum": [
        "none",
        "chosen",
        "interested",
        "declined_by_choice"
      ],
      "default": "none",
      "description": "Customer's selection in the comparison: chosen = this stage was approved, interested = customer marked interest (follow-up needed), declined_by_choice = auto-declined because another stage was chosen"
    },
    "comparison_interest": {
      "type": "boolean",
      "default": false,
      "description": "True when the customer marked interest in this stage (multi-select interest flow)"
    },
    "comparison_interest_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer last marked interest in this stage"
    },
    "comparison_interest_note": {
      "type": "string",
      "description": "Optional note the customer attached when expressing interest"
    }
  },
  "required": [
    "estimate_number",
    "customer_id"
  ]
}