{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string",
      "description": "Optional: linked CustomerEngine record"
    },
    "build_id": {
      "type": "string",
      "description": "Optional linked engine build"
    },
    "invoice_id": {
      "type": "string",
      "description": "Optional linked invoice (when converted)"
    },
    "spec_sheet_id": {
      "type": "string",
      "description": "Spec sheet used for this estimate (set when canned job is loaded)"
    },
    "is_engine_build": {
      "type": "boolean",
      "default": false,
      "description": "If true, approval creates an engine build. If false, approval creates an invoice."
    },
    "contains_illegal_parts": {
      "type": "boolean",
      "default": false,
      "description": "If true, customer must sign an Illegal Parts Acknowledgment"
    },
    "contains_contract_engine": {
      "type": "boolean",
      "default": false,
      "description": "If true, a Contract Engine IP & Seal agreement has been generated for this estimate"
    },
    "public_access_token": {
      "type": "string",
      "description": "Secure random token for public viewing without authentication"
    },
    "stripe_checkout_url": {
      "type": "string",
      "description": "Pre-generated Stripe checkout URL for public deposit/payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "expired"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "deposit_required": {
      "type": "boolean",
      "default": false
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "core_id": {
            "type": "string",
            "description": "Reference to EngineCore when selling a core from inventory"
          },
          "is_core_credit": {
            "type": "boolean",
            "default": false
          },
          "core_details": {
            "type": "object",
            "properties": {
              "core_number": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "unit_cost": {
                "type": "number"
              },
              "sell_price": {
                "type": "number"
              },
              "core_credit": {
                "type": "number"
              },
              "platform_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "description": "Machining operations on this estimate",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "none",
        "amount",
        "percentage"
      ],
      "default": "none",
      "description": "Type of discount applied to this estimate"
    },
    "discount_value": {
      "type": "number",
      "default": 0,
      "description": "Discount value \u2014 dollar amount (if type=amount) or percentage (if type=percentage)"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Calculated discount amount in dollars"
    },
    "applied_credits": {
      "type": "number",
      "default": 0,
      "description": "Account credits applied to this estimate (Performance Credit System)"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "amount_due": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "estimate_number",
    "customer_id"
  ]
}