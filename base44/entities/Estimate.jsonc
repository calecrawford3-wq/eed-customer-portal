{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string",
      "description": "Optional: linked CustomerEngine record"
    },
    "build_id": {
      "type": "string",
      "description": "Optional linked engine build"
    },
    "invoice_id": {
      "type": "string",
      "description": "Optional linked invoice (when converted)"
    },
    "is_engine_build": {
      "type": "boolean",
      "default": false,
      "description": "If true, approval creates an engine build. If false, approval creates an invoice."
    },
    "public_access_token": {
      "type": "string",
      "description": "Secure random token for public viewing without authentication"
    },
    "stripe_checkout_url": {
      "type": "string",
      "description": "Pre-generated Stripe checkout URL for public deposit/payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "expired"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "deposit_required": {
      "type": "boolean",
      "default": false
    },
    "deposit_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check",
              "other"
            ]
          },
          "note": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "estimate_number",
    "customer_id"
  ]
}