{
  "name": "BuildTask",
  "type": "object",
  "properties": {
    "build_id": {
      "type": "string",
      "description": "Linked EngineBuild"
    },
    "template_id": {
      "type": "string",
      "description": "Source WorkflowTemplate this task was generated from"
    },
    "template_name": {
      "type": "string",
      "description": "Snapshot of the template name when tasks were generated"
    },
    "name": {
      "type": "string",
      "description": "Action item name"
    },
    "stage": {
      "type": "string",
      "description": "Stage name this task belongs to"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Sort position within the build's task list"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete",
        "skipped"
      ],
      "default": "pending",
      "description": "pending = not started, in_progress = being worked, complete = done, skipped = not applicable"
    },
    "completed_by": {
      "type": "string",
      "description": "Name of the user who marked this task complete"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this task was marked complete"
    },
    "notes": {
      "type": "string",
      "description": "Optional per-task note"
    }
  },
  "required": [
    "build_id",
    "name"
  ]
}