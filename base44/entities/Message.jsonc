{
  "name": "Message",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Linked customer (resolved from phone number when possible)"
    },
    "customer_name": {
      "type": "string",
      "description": "Snapshot of customer name for display"
    },
    "contact_name": {
      "type": "string",
      "description": "Which additional contact (CustomerContact) sent/received the message, when matched"
    },
    "phone_number": {
      "type": "string",
      "description": "The other party's phone number (SMS) or Facebook sender PSID (Facebook)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "description": "Inbound = received from customer; outbound = sent by shop"
    },
    "from_number": {
      "type": "string",
      "description": "Sender phone number or PSID"
    },
    "to_number": {
      "type": "string",
      "description": "Recipient phone number or PSID"
    },
    "body": {
      "type": "string",
      "description": "Message text content"
    },
    "message_id": {
      "type": "string",
      "description": "VoIP.ms SMS ID or Facebook message ID (for dedup)"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "sent",
        "delivered",
        "failed"
      ],
      "default": "sent",
      "description": "Delivery status"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the shop has read/viewed this message"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "facebook"
      ],
      "default": "sms",
      "description": "Message channel: sms = VoIP.ms SMS, facebook = Facebook Messenger"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent or received"
    }
  },
  "required": [
    "phone_number",
    "direction",
    "body"
  ]
}