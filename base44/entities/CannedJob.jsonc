{
  "name": "CannedJob",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Canned job name"
    },
    "description": {
      "type": "string",
      "description": "Short description shown in the picker"
    },
    "line_items": {
      "type": "array",
      "description": "Parts included in this canned job",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "labor_items": {
      "type": "array",
      "description": "Labor items included in this canned job",
      "items": {
        "type": "object",
        "properties": {
          "labor_item_id": {
            "type": "string",
            "description": "Reference to the LaborItem catalog entry this canned labor was picked from \u2014 used to pull current pricing when loaded onto an estimate"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "machining_items": {
      "type": "array",
      "description": "Machining operations included in this canned job",
      "items": {
        "type": "object",
        "properties": {
          "machining_item_id": {
            "type": "string",
            "description": "Reference to the MachiningItem catalog entry \u2014 used to pull current pricing when loaded onto an estimate"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this canned job"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number of this package. Increments each time a new version is created from a previous one."
    },
    "version_group_id": {
      "type": "string",
      "description": "Shared ID linking all versions of the same package. New estimates use the latest version (is_latest=true). Old versions are preserved so approved estimates keep their original scope and prices."
    },
    "is_latest": {
      "type": "boolean",
      "default": true,
      "description": "True for the most recent version in a version group. Only one version per group should have this set. New estimates pick the latest version."
    },
    "version_notes": {
      "type": "string",
      "description": "Notes describing what changed in this version (shown in version history and diff viewer)"
    },
    "parent_version_id": {
      "type": "string",
      "description": "ID of the previous version this version was created from (for version history traversal)"
    }
  },
  "required": [
    "name"
  ]
}