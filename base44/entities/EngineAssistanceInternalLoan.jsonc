{
  "name": "EngineAssistanceInternalLoan",
  "type": "object",
  "properties": {
    "offer_id": {
      "type": "string",
      "description": "Assistance offer this in-house agreement belongs to. One agreement per offer."
    },
    "application_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "declined",
        "active",
        "completed",
        "canceled"
      ],
      "default": "pending_approval",
      "enumColors": [
        "yellow",
        "blue",
        "red",
        "green",
        "green",
        "gray"
      ],
      "description": "pending_approval = customer asked, Elite has not decided; approved = Elite set fixed APR/term and is waiting for the customer signature; declined = Elite did not approve; active = deposit collected and agreement signed; completed = fully repaid; canceled = withdrawn before activation."
    },
    "principal": {
      "type": "number",
      "default": 0,
      "description": "Amount Elite finances after the verified deposit. Recalculated at activation so the deposit plus this principal never exceed the offer total."
    },
    "apr": {
      "type": "number",
      "default": 0,
      "description": "Fixed annual percentage rate. While pending_approval this holds the indicative APR quoted to the customer; approval sets the final APR."
    },
    "term_months": {
      "type": "number",
      "default": 12
    },
    "monthly_payment": {
      "type": "number",
      "default": 0
    },
    "total_repayable": {
      "type": "number",
      "default": 0,
      "description": "Principal plus finance charge across the whole schedule"
    },
    "finance_charge": {
      "type": "number",
      "default": 0
    },
    "requested_apr": {
      "type": "number",
      "default": 0,
      "description": "Indicative APR the customer saw when they chose a plan. Never a promise of the approved rate."
    },
    "requested_term_months": {
      "type": "number",
      "default": 0,
      "description": "Number of monthly payments the customer chose on their application."
    },
    "requested_monthly_payment": {
      "type": "number",
      "default": 0,
      "description": "Scheduled payment for the customer's chosen term, computed by the server from the exact financed balance."
    },
    "requested_pricing": {
      "type": "object",
      "description": "Server-computed snapshot of the plan the customer selected, kept so staff can compare it with what they approve. The browser cannot supply these numbers.",
      "properties": {
        "principal": {
          "type": "number"
        },
        "apr": {
          "type": "number"
        },
        "term_months": {
          "type": "number"
        },
        "monthly_payment": {
          "type": "number"
        },
        "total_repayable": {
          "type": "number"
        },
        "finance_charge": {
          "type": "number"
        },
        "min_term_months": {
          "type": "number"
        },
        "max_term_months": {
          "type": "number"
        },
        "min_monthly_payment": {
          "type": "number"
        },
        "eligible_terms": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "snapshot_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "terms_changed": {
      "type": "boolean",
      "default": false,
      "description": "True when the approved APR, term or payment differs from what the customer requested. The customer must explicitly accept the changed terms before signing."
    },
    "terms_change_consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "terms_change_consent_name": {
      "type": "string"
    },
    "first_payment_date": {
      "type": "string",
      "format": "date"
    },
    "schedule": {
      "type": "array",
      "description": "Accurate installment schedule generated from principal, APR and term",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number"
          },
          "principal": {
            "type": "number"
          },
          "interest": {
            "type": "number"
          },
          "balance_after": {
            "type": "number"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "description": "Collected installments recorded by staff. Each entry is also written to the fund ledger.",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "check",
              "card",
              "ach",
              "other"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "outstanding_balance": {
      "type": "number",
      "default": 0
    },
    "disclosures_version": {
      "type": "string",
      "description": "Version label of the disclosures the customer agreed to"
    },
    "disclosures_text": {
      "type": "string",
      "description": "Snapshot of the exact disclosures shown at signature time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signed_name": {
      "type": "string",
      "description": "Typed full name of the customer accepting the agreement"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "decline_reason": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the deposit was verified and the agreement became live"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "borrower_application": {
      "type": "object",
      "description": "Customer-submitted financing application, validated and stored by the server. No Social Security number, ID number or document is ever stored here; if a provider requires an SSN it is entered only on the provider's hosted page.",
      "properties": {
        "legal_name": {
          "type": "string"
        },
        "signature_name": {
          "type": "string"
        },
        "address_line1": {
          "type": "string"
        },
        "address_line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "US"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "employment_status": {
          "type": "string",
          "enum": [
            "employed_full_time",
            "employed_part_time",
            "self_employed",
            "retired",
            "student",
            "unemployed",
            "other"
          ]
        },
        "employer_name": {
          "type": "string"
        },
        "monthly_income": {
          "type": "number"
        },
        "income_period": {
          "type": "string",
          "default": "monthly"
        },
        "consent": {
          "type": "boolean",
          "default": false
        },
        "consent_version": {
          "type": "string"
        },
        "consent_text": {
          "type": "string"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "autopay": {
      "type": "object",
      "description": "Stripe-hosted payment-method setup for optional autopay. Stores only the provider reference and the card brand/last4; no card number is ever held. Saving a card never charges it and never enables automatic collection.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_set",
            "saved",
            "revoked"
          ],
          "default": "not_set"
        },
        "provider": {
          "type": "string",
          "default": "stripe"
        },
        "payment_method_id": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "last4": {
          "type": "string"
        },
        "exp_month": {
          "type": "number"
        },
        "exp_year": {
          "type": "number"
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        },
        "livemode": {
          "type": "boolean",
          "default": false
        },
        "consent_version": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "offer_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}