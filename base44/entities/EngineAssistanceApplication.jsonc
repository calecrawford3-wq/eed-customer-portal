{
  "name": "EngineAssistanceApplication",
  "type": "object",
  "properties": {
    "application_number": {
      "type": "string",
      "description": "Staff-facing identifier (EAF-YYYY-####)"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "info_requested",
        "approved",
        "denied",
        "funded",
        "withdrawn",
        "expired"
      ],
      "default": "submitted",
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "red",
        "green",
        "gray",
        "gray"
      ],
      "description": "submitted = new, under_review = staff reviewing, info_requested = waiting on applicant, approved = award granted, denied = not approved, funded = offer paid, withdrawn = applicant or staff withdrew, expired = offer expired"
    },
    "template_key": {
      "type": "string"
    },
    "template_version": {
      "type": "number",
      "default": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "public_form",
        "staff_entry"
      ],
      "default": "public_form",
      "enumColors": [
        "blue",
        "gray"
      ]
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "household_size": {
      "type": "number"
    },
    "household_income_bracket": {
      "type": "string",
      "enum": [
        "under_35k",
        "35k_75k",
        "over_75k",
        "prefer_not_to_say"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray"
      ],
      "description": "Self-reported household income bracket. Never store tax returns or identifiers."
    },
    "years_racing": {
      "type": "number"
    },
    "racing_experience": {
      "type": "string",
      "description": "Applicant's racing background and experience"
    },
    "racing_classes": {
      "type": "string"
    },
    "racing_tracks": {
      "type": "string"
    },
    "engine_platform_text": {
      "type": "string",
      "description": "Engine or platform the applicant wants help with, as entered"
    },
    "platform_id": {
      "type": "string",
      "description": "Matched EnginePlatform when known"
    },
    "requested_help": {
      "type": "string",
      "description": "What assistance the applicant is asking for"
    },
    "hardship_explanation": {
      "type": "string",
      "description": "Applicant's own description of their hardship"
    },
    "references": {
      "type": "array",
      "description": "References supplied by the applicant. Never include government identifiers.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "description": "Every question and answer exactly as submitted, kept so a replaced template still reads correctly.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "consents": {
      "type": "object",
      "description": "Acknowledgement and consent flags captured at submission",
      "properties": {
        "truthful": {
          "type": "boolean"
        },
        "privacy": {
          "type": "boolean"
        },
        "terms": {
          "type": "boolean"
        },
        "contact": {
          "type": "boolean"
        }
      }
    },
    "consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_version": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "description": "Private supporting documents. Stored as private file URIs; only signed URLs issued by an admin-only function are exposed.",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "uploaded_by": {
            "type": "string"
          }
        }
      }
    },
    "internal_notes": {
      "type": "string",
      "description": "Staff-only notes. Never exposed publicly."
    },
    "info_request_note": {
      "type": "string",
      "description": "What staff asked the applicant for"
    },
    "info_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "info_response": {
      "type": "string",
      "description": "Applicant's reply to an information request"
    },
    "info_responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_summary": {
      "type": "string"
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string"
    },
    "assistance_type": {
      "type": "string",
      "enum": [
        "none",
        "percent",
        "fixed"
      ],
      "default": "none",
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ]
    },
    "assistance_percent": {
      "type": "number",
      "default": 0
    },
    "assistance_amount": {
      "type": "number",
      "default": 0
    },
    "customer_id": {
      "type": "string",
      "description": "Customer record this applicant became"
    },
    "offer_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "customer_engine_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "description": "Set only after the assistance offer is paid or authorized"
    },
    "status_token": {
      "type": "string",
      "description": "Long random token for the applicant's private status page. Not a record id and contains no PII."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_trail": {
      "type": "array",
      "description": "Append-only staff action log",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "application_number",
    "status",
    "first_name",
    "last_name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}