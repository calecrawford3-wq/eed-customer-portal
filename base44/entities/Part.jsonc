{
  "name": "Part",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "block",
        "rotating_assembly",
        "cylinder_head",
        "valvetrain",
        "timing",
        "oiling",
        "fasteners",
        "gaskets",
        "seals",
        "electrical",
        "other"
      ],
      "default": "other"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_part_number": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Inbound shipping cost per unit; added to unit_cost for the landed total cost and markup-based sell price"
    },
    "sell_price": {
      "type": "number"
    },
    "use_markup": {
      "type": "boolean",
      "default": false,
      "description": "If true, sell_price is auto-calculated from unit_cost + markup_percentage"
    },
    "markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "Markup percentage applied to unit_cost to derive sell_price (e.g. 50 = 50% markup)"
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0
    },
    "reservation_lock": {
      "type": "string",
      "default": "",
      "description": "Mutex lock for serializing concurrent reservation operations on this part. Stores a timestamp-based value when locked, empty when free. Stale locks (>30s) are automatically reclaimed."
    },
    "reorder_point": {
      "type": "number",
      "default": 0
    },
    "reorder_quantity": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string",
      "description": "Physical storage location (e.g. Shelf A3)"
    },
    "platform_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Compatible engine platform IDs"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discontinued",
        "special_order"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "part_number"
  ]
}