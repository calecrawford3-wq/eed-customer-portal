{
  "name": "Part",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "block",
        "rotating_assembly",
        "cylinder_head",
        "valvetrain",
        "timing",
        "oiling",
        "fasteners",
        "gaskets",
        "seals",
        "electrical",
        "other"
      ],
      "default": "other"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_part_number": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Inbound shipping cost per unit; added to unit_cost for the landed total cost and markup-based sell price"
    },
    "sell_price": {
      "type": "number"
    },
    "use_markup": {
      "type": "boolean",
      "default": false,
      "description": "If true, sell_price is auto-calculated from unit_cost + markup_percentage"
    },
    "markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "Markup percentage applied to unit_cost to derive sell_price (e.g. 50 = 50% markup)"
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0
    },
    "inventory_operation_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Durable idempotency markers for atomic inventory quantity movements; do not edit manually"
    },
    "reservation_lock": {
      "type": "string",
      "default": "",
      "description": "Mutex lock for serializing concurrent reservation operations on this part"
    },
    "reorder_point": {
      "type": "number",
      "default": 0
    },
    "reorder_quantity": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string",
      "description": "Physical storage location (e.g. Shelf A3)"
    },
    "platform_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Compatible engine platform IDs"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discontinued",
        "special_order"
      ],
      "default": "active"
    },
    "website_published": {
      "type": "boolean",
      "default": false,
      "description": "Explicit opt-in to display this part in the public Elite website store"
    },
    "website_description": {
      "type": "string",
      "description": "Optional customer-facing description"
    },
    "website_image_url": {
      "type": "string",
      "description": "Optional public image URL"
    },
    "website_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Additional public product photo URLs shown in the website store gallery. The first photo is the primary listing image."
    },
    "website_details": {
      "type": "array",
      "default": [],
      "description": "Customer-facing expandable information sections for the website listing. Each entry has a custom heading chosen by the shop and the content revealed when a customer opens that dropdown.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Heading shown on the dropdown (e.g. Fitment, Install Notes, What's Included)"
          },
          "content": {
            "type": "string",
            "description": "Information revealed when the customer opens the dropdown"
          }
        }
      }
    },
    "website_featured": {
      "type": "boolean",
      "default": false
    },
    "website_shipping_weight_oz": {
      "type": "number",
      "minimum": 0,
      "description": "Packed item weight in ounces for website carrier quotes"
    },
    "website_shipping_length_in": {
      "type": "number",
      "minimum": 0
    },
    "website_shipping_width_in": {
      "type": "number",
      "minimum": 0
    },
    "website_shipping_height_in": {
      "type": "number",
      "minimum": 0
    },
    "website_shipping_requires_quote": {
      "type": "boolean",
      "default": false,
      "description": "Require manual shipping quote for oversized or special handling parts"
    }
  },
  "required": [
    "name",
    "part_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}