{
  "name": "EngineAssistanceSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Always 'global'"
    },
    "fund_name": {
      "type": "string",
      "default": "Affordable Engine Fund",
      "description": "Customer-facing name of the assistance program"
    },
    "fund_public_intro": {
      "type": "string",
      "description": "Short public description shown on the application form and offer page"
    },
    "active_template_key": {
      "type": "string",
      "description": "Key of the EngineAssistanceTemplate currently used for new applications"
    },
    "default_offer_expiry_days": {
      "type": "number",
      "default": 21,
      "minimum": 1,
      "maximum": 180
    },
    "min_financing_amount": {
      "type": "number",
      "default": 3000,
      "description": "Amount at or above which financing is prioritized. Not a guarantee of approval."
    },
    "financing_methods": {
      "type": "array",
      "description": "Last known lender availability from the payment provider. 'unknown' means it has not been checked, never that the customer was declined.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean",
            "default": false
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "financing_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "financing_check_error": {
      "type": "string",
      "description": "Safe message when availability could not be read from the provider"
    },
    "payments_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when the portal Stripe keys and webhook secret are configured. Set by the provider check, never by the browser."
    },
    "payments_disabled_reason": {
      "type": "string",
      "description": "Plain setup instruction shown to staff when online payment is not configured"
    },
    "offer_terms_text": {
      "type": "string",
      "description": "Default terms printed on every assistance offer"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}