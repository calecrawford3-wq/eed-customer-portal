{
  "name": "EngineAssistanceSettings",
  "type": "object",
  "properties": {
    "split_financing_authorizations":{"type":"object","description":"Per-provider written authorization reference for partial charges on one build. Absent means disabled.","properties":{"affirm":{"type":"string"},"sunbit":{"type":"string"},"klarna":{"type":"string"},"afterpay_clearpay":{"type":"string"}}},
    "acorn_enabled": {"type":"boolean","default":false,"description":"Enable after Acorn confirms merchant eligibility for racing engine builds."},
    "key": {
      "type": "string",
      "description": "Always 'global'"
    },
    "fund_name": {
      "type": "string",
      "default": "Affordable Engine Fund",
      "description": "Customer-facing name of the assistance program"
    },
    "fund_public_intro": {
      "type": "string",
      "description": "Short public description shown on the application form and offer page"
    },
    "active_template_key": {
      "type": "string",
      "description": "Key of the EngineAssistanceTemplate currently used for new applications"
    },
    "default_offer_expiry_days": {
      "type": "number",
      "default": 21,
      "minimum": 1,
      "maximum": 180
    },
    "min_financing_amount": {
      "type": "number",
      "default": 3000,
      "description": "Amount at or above which financing is prioritized. A label only: it never blocks financing of a smaller balance."
    },
    "financing_methods": {
      "type": "array",
      "description": "Last known lender availability from the payment provider. 'unknown' means it has not been checked, never that the customer was declined.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean",
            "default": false
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "financing_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "financing_check_error": {
      "type": "string",
      "description": "Safe message when availability could not be read from the provider"
    },
    "payments_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when the portal Stripe keys and webhook secret are configured. Set by the provider check, never by the browser."
    },
    "payments_disabled_reason": {
      "type": "string",
      "description": "Plain setup instruction shown to staff when online payment is not configured"
    },
    "default_deposit_percent": {
      "type": "number",
      "default": 50,
      "description": "Default upfront deposit percentage for the deposit + in-house financing pathway (10-90)"
    },
    "internal_financing_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When off, the deposit + Elite in-house financing pathways are disabled and shown as unavailable"
    },
    "internal_financing_apr": {
      "type": "number",
      "default": 0,
      "description": "Indicative fixed APR shown on customer payment options. 0 means no finance charge. Staff set the final APR on each agreement."
    },
    "internal_financing_term_months": {
      "type": "number",
      "default": 12,
      "description": "Preferred repayment term in months. Offered only when its scheduled payment meets the minimum installment."
    },
    "internal_financing_min_term_months": {
      "type": "number",
      "default": 3,
      "description": "Shortest repayment term a customer may choose (subject to legal configuration)"
    },
    "internal_financing_max_term_months": {
      "type": "number",
      "default": 24,
      "description": "Longest repayment term Elite allows. The term actually offered is also capped so the scheduled payment never falls below the minimum installment."
    },
    "internal_financing_min_monthly_payment": {
      "type": "number",
      "default": 100,
      "description": "Hard minimum scheduled monthly installment. No term whose regular payment is below this amount is ever shown, accepted or approved."
    },
    "internal_financing_disclosure_text": {
      "type": "string",
      "description": "Disclosure language the customer signs before an in-house agreement becomes live"
    },
    "offer_terms_text": {
      "type": "string",
      "description": "Default terms printed on every assistance offer"
    },
    "internal_notes": {
      "type": "string"
    },
    "agreement_template_key": {
      "type": "string",
      "description": "Key of the Oklahoma retail installment agreement template in use"
    },
    "agreement_template_version": {
      "type": "number",
      "default": 1
    },
    "agreement_template_hash": {
      "type": "string",
      "description": "SHA-256 of the template wording. Recorded whenever the template status changes."
    },
    "agreement_template_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved_counsel"
      ],
      "default": "draft",
      "enumColors": [
        "red",
        "green"
      ],
      "description": "draft = DRAFT / NOT LEGALLY REVIEWED. Live in-house lending is blocked while the template is a draft."
    },
    "agreement_counsel_firm": {
      "type": "string",
      "description": "Oklahoma law firm that reviewed the template"
    },
    "agreement_counsel_approved_by": {
      "type": "string",
      "description": "Qualified Oklahoma attorney who approved the template"
    },
    "agreement_counsel_approved_at": {
      "type": "string",
      "format": "date"
    },
    "agreement_counsel_reference": {
      "type": "string",
      "description": "Counsel file or opinion reference recorded for the approval"
    },
    "in_house_lending_live": {
      "type": "boolean",
      "default": false,
      "description": "Live in-house lending switch. Honored only while the agreement template status is approved_counsel."
    },
    "late_fee_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Off by default. Enable only where the late fee is legally permissible for this contract and amount."
    },
    "late_fee_percent": {
      "type": "number",
      "default": 5,
      "description": "Late fee as a percentage of the overdue installment, applied at most once per late payment"
    },
    "late_fee_grace_days": {
      "type": "number",
      "default": 10,
      "description": "Days after the due date before a late fee may apply"
    },
    "cure_period_days": {
      "type": "number",
      "default": 21,
      "description": "Cure period stated in the notice before any further collection step"
    },
    "autopay_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When off, no autopay authorization is offered and installments are collected manually"
    },
    "servicing_phone": {
      "type": "string",
      "description": "Number customers call about payments or hardship"
    },
    "servicing_email": {
      "type": "string"
    },
    "dispute_email": {
      "type": "string",
      "description": "Where a customer sends a billing dispute or correction request"
    },
    "notice_address": {
      "type": "string",
      "description": "Mailing address for written notices required by the agreement"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}