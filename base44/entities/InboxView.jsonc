{
  "name": "InboxView",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for this saved inbox filter preset"
    },
    "dirFilter": {
      "type": "string",
      "default": "all"
    },
    "mailboxFilter": {
      "type": "string",
      "default": "all"
    },
    "categoryFilter": {
      "type": "string",
      "default": "all"
    },
    "unreadOnly": {
      "type": "boolean",
      "default": false
    },
    "needsActionOnly": {
      "type": "boolean",
      "default": false
    },
    "search": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}