{
  "name": "EmailThread",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Zoho Mail thread/conversation ID"
    },
    "account_id": {
      "type": "string"
    },
    "account_address": {
      "type": "string",
      "description": "Mailbox address this thread belongs to"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the latest message in the thread"
    },
    "normalized_subject": {
      "type": "string",
      "description": "Subject with Re:/Fwd: prefixes stripped, used for grouping and search"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All unique email addresses that sent or received a message in this thread"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "has_attachments": {
      "type": "boolean",
      "default": false
    },
    "link_type": {
      "type": "string",
      "enum": [
        "none",
        "purchase_order",
        "invoice",
        "estimate",
        "build"
      ],
      "default": "none",
      "description": "Denormalized primary document link for quick list badges"
    },
    "link_number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "uncategorized",
        "priority",
        "customer",
        "supplier",
        "billing",
        "promotional",
        "notifications",
        "other"
      ],
      "default": "uncategorized",
      "description": "AI-assigned or user-set category used to sort the inbox (promotional vs work, etc.)"
    },
    "category_source": {
      "type": "string",
      "enum": [
        "uncategorized",
        "ai",
        "manual"
      ],
      "default": "uncategorized",
      "description": "Provenance of the category: 'manual' = set by a user (used as AI training examples and never overwritten by AI), 'ai' = assigned by the LLM"
    },
    "categorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_user_id": {
      "type": "string",
      "description": "Staff member assigned to handle this thread"
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "new",
        "open",
        "waiting_on_customer",
        "waiting_on_supplier",
        "scheduled_followup",
        "resolved",
        "closed"
      ],
      "default": "new",
      "description": "Action-center workflow status. A thread stays actionable until it reaches resolved/closed, even after being read."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Date by which this thread must be handled or replied to"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Next planned follow-up date (used by reminder automations)"
    },
    "follow_up_reminder_type": {
      "type": "string",
      "enum": [
        "none",
        "tomorrow",
        "three_days",
        "specific_date",
        "no_reply",
        "snooze_engine"
      ],
      "default": "none",
      "description": "Kind of follow-up reminder attached to the thread"
    },
    "last_action_owner_id": {
      "type": "string",
      "description": "User who last changed the thread's workflow state"
    },
    "last_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the thread's workflow state last changed"
    },
    "internal_notes": {
      "type": "string",
      "description": "Staff-only notes about this thread (not sent to customers, not synced to Zoho)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "thread_id",
    "account_id"
  ]
}