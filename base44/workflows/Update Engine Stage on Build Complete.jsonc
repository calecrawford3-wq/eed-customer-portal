{
  "name": "Update Engine Stage on Build Complete",
  "description": "When a build is marked complete or shipped, updates the linked CustomerEngine's current_stage from the build's spec sheet.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"complete\" or .trigger.data.status == \"shipped\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EngineBuild"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "update_engine_stage_on_build_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onBuildComplete",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onBuildComplete"
  }
}