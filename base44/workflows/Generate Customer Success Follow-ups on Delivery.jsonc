{
  "name": "Generate Customer Success Follow-ups on Delivery",
  "description": "When an engine build is marked Shipped, create the 7 post-delivery follow-up tasks and a delivery calendar event.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"shipped\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EngineBuild"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_customer_success_follow_ups_on_delivery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateCustomerSuccessTasks",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateCustomerSuccessTasks"
  }
}