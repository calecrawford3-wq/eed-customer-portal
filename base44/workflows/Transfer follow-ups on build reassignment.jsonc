{
  "name": "Transfer follow-ups on build reassignment",
  "description": "When an engine build is reassigned to a different customer, transfer the remaining (pending) follow-up tasks and delivery calendar event to the new customer.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"customer_id\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EngineBuild"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "transfer_follow_ups_on_build_reassignment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleBuildLifecycle",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleBuildLifecycle"
  }
}