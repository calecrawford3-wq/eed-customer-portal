{
  "name": "Process Cores on Invoice Complete",
  "description": "When an invoice is marked paid: adds customer cores (from core credit lines) to core inventory and deducts sold cores (from core sell lines) from core inventory.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"paid\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Invoice"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_cores_on_invoice_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processCoresOnInvoiceComplete",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processCoresOnInvoiceComplete"
  }
}