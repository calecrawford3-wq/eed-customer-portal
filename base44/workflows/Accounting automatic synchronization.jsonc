{
  "name": "Accounting automatic synchronization",
  "description": "Sync Stripe paid payouts and newly recorded expenses to virtual ledger every 15 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "namespace": "base44",
      "name": "accounting-auto-sync",
      "version": "1.0.0"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAccounting",
            "payload": {}
          },
          "then": "end"
        }
      }
    ]
  }
}