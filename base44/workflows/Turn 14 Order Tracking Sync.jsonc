{
  "name": "Turn 14 Order Tracking Sync",
  "description": "Checks submitted Turn 14 shop and website supplier orders every 30 minutes for tracking, emails new tracking to website customers, and updates fulfillment.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "turn14_order_tracking_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "turn14SyncOrderTracking",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}