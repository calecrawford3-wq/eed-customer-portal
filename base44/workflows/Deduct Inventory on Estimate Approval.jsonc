{
  "trigger": {
    "condition": "${ (.trigger.data.status == \"approved\") or (.trigger.old_data.status == \"approved\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Estimate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reserve_inventory_on_estimate_approval",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deductInventoryOnApproval",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "Reserves available parts for engine-build estimates when approved (without reducing quantity_on_hand). Releases reservations when approval is withdrawn. Reconciles demand when an approved estimate's parts or addons change. Non-engine-build estimates are skipped. Re-running reconciles demand instead of double-reserving.",
  "name": "Reserve Inventory on Estimate Approval",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "deductInventoryOnApproval"
  }
}