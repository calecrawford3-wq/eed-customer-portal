{
  "name": "Deduct Inventory on Estimate Approval",
  "description": "Automatically deducts part quantities from inventory when an estimate is marked as approved.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Estimate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deduct_inventory_on_estimate_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deductInventoryOnApproval",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "deductInventoryOnApproval"
  }
}